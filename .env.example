# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Generate random values, e.g. PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))

# --- Database (PostgreSQL) ---
DB_NAME=universalshield
DB_USERNAME=universalshield
DB_PASSWORD=replace-with-a-long-random-password
# Used when running the jar directly against PostgreSQL (docker-compose builds this itself):
DB_URL=jdbc:postgresql://localhost:5432/universalshield

# --- Security ---
# Random string of at least 32 characters; the prod profile refuses to start without it.
APP_HASH_SECRET=replace-with-at-least-32-random-characters
# true behind HTTPS (production). false only for http://localhost testing.
COOKIE_SECURE=false
# Comma-separated extra origins allowed to call the API with credentials (empty = same origin only).
CORS_ALLOWED_ORIGINS=
# Expose /api/openapi and /swagger-ui.html without login (default false in prod).
API_DOCS_PUBLIC=false

# --- Optional tuning ---
PORT=8080
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=85
TRANSACTION_LARGE_AMOUNT=10000
RETENTION_DEFAULT_DAYS=90
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SCANS_PER_MINUTE=30
ML_ENABLED=true
ML_MODEL_DIR=models

# --- Dev profile only ---
DEMO_PASSWORD=ShieldDemo
